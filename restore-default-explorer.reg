Windows Registry Editor Version 5.00

; Restore default Windows Explorer folder handler
[-HKEY_CURRENT_USER\Software\Classes\Directory\shell\open]

; Restore default Windows Explorer drive handler
[-HKEY_CURRENT_USER\Software\Classes\Drive\shell\open]

; Restore default Windows Explorer generic folder handler
[-HKEY_CURRENT_USER\Software\Classes\Folder\shell\open]

; Restore default Windows Explorer Win + E hotkey
[-HKEY_CURRENT_USER\Software\Classes\CLSID\{52205fd8-5dfb-447d-801a-d0b52f2e83e1}]
